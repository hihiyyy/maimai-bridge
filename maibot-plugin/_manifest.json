{
  "manifest_version": 2,
  "id": "lirick.maimai-bridge",
  "version": "1.1.0",
  "name": "Maibot互联DSH",
  "description": "把 MaiBot 和 DeepSeek Harness 连起来：人格互通、记忆双向、双向调用；能自己出去看网页、真的看 B 站视频、看到喜欢的会自己点赞收藏；出门前会先申请，回来会汇报。",
  "author": {
    "name": "lirick",
    "url": "https://github.com/hihiyyy"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/hihiyyy/maimai-bridge",
    "homepage": "https://github.com/hihiyyy/maimai-bridge",
    "documentation": "https://github.com/hihiyyy/maimai-bridge",
    "issues": "https://github.com/hihiyyy/maimai-bridge/issues"
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "link",
      "fallback": "plug"
    }
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "personality.get_current",
    "knowledge.search",
    "maisaka.reply.generate",
    "maisaka.proactive.trigger",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
