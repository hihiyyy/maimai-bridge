{
  "name": "@local/dsh-maimai-settings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 设置页：把 DeepSeek Harness 收到 MaiBot（麦麦）的人格与长期记忆上，并支持任务互派",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "maibot", "cordis"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
